{
  "manifest_version": 3,
  "name": "Bootstrap Grid Overlay",
  "version": "0.1.0",
  "description": "Show a Bootstrap-style column grid overlay on any page, without requiring Bootstrap DOM classes.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Bootstrap Grid Overlay",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-grid-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Toggle Bootstrap grid overlay"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
